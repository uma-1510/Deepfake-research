ebooks/umachinnam/notebookbbb93b7aed/frames'\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(\"Device:\", device)\n\nIMAGENET_MEAN, IMAGENET_STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\nmodel_transform = T.Compose([T.Resize((224,224)), T.ToTensor(), T.Normalize(IMAGENET_MEAN, IMAGENET_STD)])\n\nclass CelebDFFrameDataset(Dataset):\n    def __init__(self, root_dir, split, transform=None):\n        real = glob.glob(os.path.join(root_dir, split, 'real', '*.jpg'))\n        fake = glob.glob(os.path.join(root_dir, split, 'fake', '*.jpg'))\n        self.samples = [(p, 0) for p in real] + [(p, 1) for p in fake]\n        self.transform = transform\n        print(f\"{split}: {len(real)} real, {len(fake)} fake\")\n    def __len__(self): return len(self.samples)\n    def __getitem__(self, idx):\n        path, label = self.samples[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        return img, label, path\n\ntest_ds_model = CelebDFFrameDataset(DATA_DIR, 'test', model_transform)\ntest_loader = DataLoader(test_ds_model, batch_size=32, shuffle=False, num_workers=2)\n\n# weights=None -- skips the network download entirely, since we load our own trained weights next\nmodel = resnet50(weights=None)\nmodel.fc = nn.Sequential(nn.Dropout(0.3), nn.Linear(model.fc.in_features, 1))\nmodel = model.to(device)\n\n# Find the checkpoint -- check both possible locations\npossible_paths = [\n    '/kaggle/working/best_resnet50_seed42.pt',\n    '/kaggle/input/notebooks/umachinnam/notebookbbb93b7aed/best_resnet50_seed42.pt',\n]\nckpt_path = next((p for p in possible_paths if os.path.exists(p)), None)\nprint(\"Checkpoint found at:\", ckpt_path)\n\nif ckpt_path is None:\n    print(\"NO CHECKPOINT FOUND -- stop here and tell me, don't proceed\")\nelse:\n    model.load_state_dict(torch.load(ckpt_path, map_location=device))\n    model.eval()\n\n    results = []\n    with torch.no_grad():\n        for imgs, labels, paths in test_loader:\n            probs = torch.sigmoid(model(imgs.to(device)).squeeze(1)).cpu().numpy()\n            preds = (probs > 0.5).astype(int)\n            for img, label, pred, prob, path in zip(imgs, labels.numpy(), preds, probs, paths):\n                results.append((img, label, pred, prob, path))\n            if len(results) > 200:\n                break\n\n    correct_real = [r for r in results if r[1]==0 and r[2]==0][:2]\n    correct_fake = [r for r in results if r[1]==1 and r[2]==1][:2]\n    wrong_real   = [r for r in results if r[1]==0 and r[2]==1][:2]\n    wrong_fake   = [r for r in results if r[1]==1 and r[2]==0][:2]\n\n    examples = correct_real + correct_fake + wrong_real + wrong_fake\n    fig, axes = plt.subplots(2, 4, figsize=(14, 7))\n    for ax, (img, label, pred, prob, path) in zip(axes.flat, examples):\n        denorm = img.permute(1,2,0).cpu().numpy()\n        denorm = (denorm * [0.229,0.224,0.225]) + [0.485,0.456,0.406]\n        ax.imshow(denorm.clip(0,1))\n        truth = 'Real' if label==0 else 'Fake'\n        predicted = 'Real' if pred==0 else 'Fake'\n        correct = \"✓\" if label==pred else \"✗\"\n        ax.set_title(f\"{correct} True: {truth} | Pred: {predicted} ({prob:.2f})\", fontsize=9)\n        ax.axis('off')\n    plt.tight_layout()\n    plt.savefig('/kaggle/working/example_predictions.png', dpi=150, bbox_inches='tight')\n    plt.show()\n    print(\"Saved example_predictions.png\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-17T01:18:29.041264Z","iopub.execute_input":"2026-08-17T01:18:29.041713Z","iopub.status.idle":"2026-08-17T01:18:35.145826Z","shell.execute_reply.started":"2026-08-17T01:18:29.041683Z","shell.execute_reply":"2026-08-17T01:18:35.144823Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\ntest: 3560 real, 6800 fake\nCheckpoint found at: /kaggle/input/notebooks/umachinnam/notebookbbb93b7aed/best_resnet50_seed42.pt\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x700 with 8 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Saved example_predictions.png\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"import os, glob, random, time, torch, torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\nimport torchvision.transforms as T\nfrom torchvision.models import vit_b_16, ViT_B_16_Weights\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score\nimport numpy as np\n\nDATA_DIR = '/kaggle/input/notebooks/umachinnam/notebookbbb93b7aed/frames'\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(\"Device:\", device)\n\nIMAGENET_MEAN, IMAGENET_STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\nmodel_transform = T.Compose([T.Resize((224,224)), T.ToTensor(), T.Normalize(IMAGENET_MEAN, IMAGENET_STD)])\n\nclass CelebDFFrameDatasetCapped(Dataset):\n    def __init__(self, samples, transform=None):\n        self.samples = samples\n        self.transform = transform\n    def __len__(self): return len(self.samples)\n    def __getitem__(self, idx):\n        path, label = self.samples[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        return img, label, path\n\ndef get_capped_train_samples(root_dir, target_real=9976, target_fake=20010, seed=42):\n    real = sorted(glob.glob(os.path.join(root_dir, 'train', 'real', '*.jpg')))\n    fake = sorted(glob.glob(os.path.join(root_dir, 'train', 'fake', '*.jpg')))\n    rng = random.Random(seed)\n    real_capped = rng.sample(real, min(target_real, len(real)))\n    fake_capped = rng.sample(fake, min(target_fake, len(fake)))\n    return [(p, 0) for p in real_capped] + [(p, 1) for p in fake_capped]\n\ndef get_test_samples(root_dir):\n    real = sorted(glob.glob(os.path.join(root_dir, 'test', 'real', '*.jpg')))\n    fake = sorted(glob.glob(os.path.join(root_dir, 'te