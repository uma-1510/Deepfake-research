   for p in backbone_params: p.requires_grad = False\n    optimizer = torch.optim.AdamW(head_params, lr=1e-4, weight_decay=1e-4)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs_p1)\n    criterion = nn.BCEWithLogitsLoss()\n    best_auc = -1\n\n    for epoch in range(1, epochs_p1 + epochs_p2 + 1):\n        if epoch == epochs_p1 + 1:\n            for p in backbone_params: p.requires_grad = True\n            optimizer = torch.optim.AdamW(\n                [{'params': head_params, 'lr': 1e-4},\n                 {'params': backbone_params, 'lr': 1e-5}], weight_decay=1e-4)\n            scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs_p2)\n        model.train(); running_loss = 0\n        for imgs, labels, _ in train_loader:\n            imgs, labels = imgs.to(device), labels.float().to(device)\n            optimizer.zero_grad()\n            loss = criterion(model(imgs).squeeze(1), labels)\n            loss.backward(); optimizer.step()\n            running_loss += loss.item()\n        scheduler.step()\n        y_true, y_score = evaluate(model)\n        auc = roc_auc_score(y_true, y_score)\n        print(f\"[mobilenet_v3_large seed{seed}] epoch {epoch}: loss={running_loss/len(train_loader):.4f}, AUC={auc:.4f}\")\n        if auc > best_auc:\n            best_auc = auc\n            torch.save(model.state_dict(), f'/kaggle/working/best_mobilenet_v3_large_seed{seed}.pt')\n    return best_auc\n\nstart = time.time()\nbest_auc_mnv3 = train_and_evaluate(seed=43)\nelapsed = round((time.time() - start) / 60, 1)\nprint(f\"\\nDone: AUC={best_auc_mnv3:.4f}, time={elapsed} min\")\n\nall_final_metrics_s43 = [\n    {'model': 'efficientnet_b0', 'seed': 43, 'auc_roc': 0.8477},\n    {'model': 'resnet50', 'seed': 43, 'auc_roc': 0.9211},\n    {'model': 'mobilenet_v3_large', 'seed': 43, 'auc_roc': best_auc_mnv3, 'train_time_min': elapsed},\n]\nresults_s43 = pd.DataFrame(all_final_metrics_s43)\nprint(results_s43)\nresults_s43.to_csv(