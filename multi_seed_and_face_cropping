a.is_available() else 'cpu')\nprint(\"Device:\", device)\n\nIMAGENET_MEAN, IMAGENET_STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\nmodel_transform = T.Compose([T.Resize((224,224)), T.ToTensor(), T.Normalize(IMAGENET_MEAN, IMAGENET_STD)])\n\nclass CelebDFFrameDatasetCapped(Dataset):\n    def __init__(self, samples, transform=None):\n        self.samples = samples\n        self.transform = transform\n    def __len__(self): return len(self.samples)\n    def __getitem__(self, idx):\n        path, label = self.samples[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        return img, label, path\n\ndef get_capped_train_samples(root_dir, target_real=9976, target_fake=20010, seed=42):\n    real = sorted(glob.glob(os.path.join(root_dir, 'train', 'real', '*.jpg')))\n    fake = sorted(glob.glob(os.path.join(root_dir, 'train', 'fake', '*.jpg')))\n    rng = random.Random(seed)\n    real_capped = rng.sample(real, min(target_real, len(real)))\n    fake_capped = rng.sample(fake, min(target_fake, len(fake)))\n    return [(p, 0) for p in real_capped] + [(p, 1) for p in fake_capped]\n\ndef get_test_samples(root_dir):\n    real = sorted(glob.glob(os.path.join(root_dir, 'test', 'real', '*.jpg')))\n    fake = sorted(glob.glob(os.path.join(root_dir, 'test', 'fake', '*.jpg')))\n    return [(p, 0) for p in real] + [(p, 1) for p in fake]\n\ntrain_samples = get_capped_train_samples(DATA_DIR, seed=42)\ntest_samples = get_test_samples(DATA_DIR)\ntrain_ds_model = CelebDFFrameDatasetCapped(train_samples, model_transform)\ntest_ds_model = CelebDFFrameDatasetCapped(test_samples, model_transform)\ntrain_loader = DataLoader(train_ds_model, batch_size=32, shuffle=True, num_workers=2)\ntest_loader = DataLoader(test_ds_model, batch_size=32, shuffle=False, num_workers=2)\nprint(f\"Train: {len(train_samples)}, Test: {len(test_samples)}\")\n\n# This line requires internet -- watch closely\nprint(\"Downloading ViT-B/16 weights...\")\nmodel = vit_b_16(weights=ViT_B_16_Weights.IMAGENET1K_V1)\nin_features = model.heads.head.in_features\nmodel.heads = nn.Sequential(nn.Dropout(0.3), nn.Linear(in_features, 1))\nmodel = model.to(device)\nprint(\"ViT loaded successfully.\")\n\ndef evaluate(model):\n    model.eval(); labels_all, scores_all = [], []\n    with torch.no_grad():\n        for imgs, labels, _ in test_loader:\n            probs = torch.sigmoid(model(imgs.to(device)).squeeze(1)).cpu().numpy()\n            scores_all.extend(probs); labels_all.extend(labels.numpy())\n    return np.array(labels_all), np.array(scores_all)\n\n# TIME-BOXED: 2 warm-up + 3 fine-tune = 5 epochs total (vs. the usual 3+7)\nEPOCHS_P1, EPOCHS_P2 = 2, 3\nhead_params = list(model.heads.parameters())\nbackbone_params = [p for n, p in model.named_parameters() if not n.startswith('heads.')]\nfor p in backbone_params: p.requires_grad = False\noptimizer = torch.optim.AdamW(head_params, lr=1e-4, weight_decay=1e-4)\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS_P1)\ncriterion = nn.BCEWithLogitsLoss()\nbest_auc = -1\n\nstart = time.time()\nfor epoch in range(1, EPOCHS_P1 + EPOCHS_P2 + 1):\n    if epoch == EPOCHS_P1 + 1:\n        for p in backbone_params: p.requires_grad = True\n        optimizer = torch.optim.AdamW(\n            [{'params': head_params, 'lr': 1e-4},\n             {'params': backbone_params, 'lr': 1e-5}], weight_decay=1e-4)\n        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS_P2)\n\n    model.train(); running_loss = 0\n    for imgs, labels, _ in train_loader:\n        imgs, labels = imgs.to(device), labels.float().to(device)\n        optimizer.zero_grad()\n        loss = criterion(model(imgs).squeeze(1), labels)\n        loss.backward(); optimizer.step()\n        running_loss += loss.item()\n    scheduler.step()\n\n    y_true, y_score = evaluate(model)\n    auc = roc_auc_score(y_true, y_score)\n    elapsed_so_far = round((time.time() - start) / 60, 1)\n    print(f\"[vit_b_16] epoch {epoch}: loss={running_loss/len(train_loader):.4f}, AUC={auc:.4f}, elapsed={elapsed_so_far} min\")\n    if auc > best_auc:\n        best_auc = auc\n        torch.save(model.state_dict(), '/kaggle/working/best_vit_b_16_seed42.pt')\n\ntotal_time = round((time.time() - start) / 60, 1)\ny_true, y_score = evaluate(model)\ny_pred = (y_score > 0.5).astype(int)\nprint(f\"\\nDone: best AUC={best_auc:.4f}, total time={total_time} min\")\nprint({'accuracy': accuracy_score(y_true, y_pred), 'precision': precision_score(y_true, y_pred),\n       'recall': recall_score(y_true, y_pred), 'f1': f1_score(y_true, y_pred), 'auc_roc': best_auc})","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-17T01:21:48.207551Z","iopub.execute_input":"2026-08-17T01:21:48.207971Z","iopub.status.idle":"2026-08-17T01:22:21.580641Z","shell.execute_reply.started":"2026-08-17T01:21:48.207939Z","shell.execute_reply":"2026-08-17T01:22:21.579393Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\nTrain: 29986, Test: 10360\nDownloading ViT-B/16 weights...\nDownloading: \"https://download.pytorch.org/models/vit_b_16-c867db91.pth\" to /root/.cache/torch/hub/checkpoints/vit_b_16-c867db91.pth\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mgaierror\u001b[0m                                  Traceback (most recent call last)","\u001b[0;32m/usr/lib/python3.12/urllib/request.py\u001b[0m in \u001b[0;36mdo_open\u001b[0;34m(self, http_class, req, **http_conn_args)\u001b[0m\n\u001b[1;32m   1343\u001b[0m             \u001b[0;32mtry\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1344\u001b[0;31m                 h.request(req.get_method(), req.selector, req.data, headers,\n\u001b[0m\u001b[1;32m   1345\u001b[0m                           encode_chunked=req.has_header('Transfer-encoding'))\n","\u001b[0;32m/usr/lib/python3.12/http/cl